---
import { existsSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

const rootDir = join(process.cwd(), 'public', 'gallery');
const imagePattern = /\.(jpe?g|png|gif|webp|avif)$/i;

const getAlbumPhotos = (directory: string, albumName?: string) =>
  readdirSync(directory, { withFileTypes: true })
    .filter((entry) => entry.isFile() && imagePattern.test(entry.name))
    .map((entry) => {
      const filePath = join(directory, entry.name);
      const { mtimeMs } = statSync(filePath);

      return {
        src: albumName ? `/gallery-optimized/${albumName}/${entry.name.replace(/\.[^/.]+$/, '.webp')}` : `/gallery-optimized/${entry.name.replace(/\.[^/.]+$/, '.webp')}`,
        alt: entry.name.replace(/\.[^/.]+$/, '') || 'photo',
        mtimeMs,
      };
    })
    .sort((a, b) => b.mtimeMs - a.mtimeMs)
    .map(({ src, alt }) => ({ src, alt }));

const getCoverPhoto = (directory: string, albumName?: string) => {
  const indexFile = readdirSync(directory, { withFileTypes: true })
    .find((entry) => entry.isFile() && /^index\.[^./\\]+$/i.test(entry.name));

  if (!indexFile) {
    const photos = getAlbumPhotos(directory, albumName);
    return photos[0]?.src ?? '';
  }

  return albumName ? `/gallery-optimized/${albumName}/${indexFile.name.replace(/\.[^/.]+$/, '.webp')}` : `/gallery-optimized/${indexFile.name.replace(/\.[^/.]+$/, '.webp')}`;
};

const albums = [] as Array<{ title: string; cover: string; photos: Array<{ src: string; alt: string }> }>;

if (existsSync(rootDir)) {
  const entries = readdirSync(rootDir, { withFileTypes: true });
  const folderAlbums = entries
    .filter((entry) => entry.isDirectory())
    .map((entry) => {
      const dirPath = join(rootDir, entry.name);
      const photos = getAlbumPhotos(dirPath, entry.name);

      return photos.length > 0
        ? {
            title: entry.name,
            cover: getCoverPhoto(dirPath, entry.name) || photos[0].src,
            photos,
          }
        : null;
    })
    .filter(Boolean) as Array<{ title: string; cover: string; photos: Array<{ src: string; alt: string }> }>;

  if (folderAlbums.length > 0) {
    albums.push(...folderAlbums);
  } else {
    const rootPhotos = getAlbumPhotos(rootDir);
    if (rootPhotos.length > 0) {
      const defaultCover = getCoverPhoto(rootDir);
      albums.push({
        title: '默认相册',
        cover: defaultCover || rootPhotos[0].src,
        photos: rootPhotos,
      });
    }
  }
}
---

<BaseLayout title="照片 - czwzzz.my">
  <div class="upload-page">
    <div class="upload-header">
      <p class="page-kicker">MEMORY / ALBUM</p>
      <h1>照片</h1>
    </div>

    <section class="gallery-section" aria-labelledby="gallery-title">
      <div class="section-heading">
        <p class="section-label" id="gallery-title">相册分类</p>
      </div>

      {albums.length > 0 ? (
        <div class="album-grid">
          {albums.map((album) => (
            <a
              href={`/photos/${encodeURIComponent(album.title)}`}
              class="album-card"
              aria-label={`查看${album.title}`}
            >
              <img src={album.cover} alt={album.title} loading="lazy" decoding="async" />
              <div class="album-meta">
                <h2>{album.title}</h2>
                <span>{album.photos.length} 张</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <span>暂无相册</span>
          <p>请在 public/gallery 下创建独立文件夹，并将每个相册图片放入对应文件夹中。若暂时保留根目录图片，将自动显示为“默认相册”。</p>
        </div>
      )}
    </section>
  </div>

</BaseLayout>
