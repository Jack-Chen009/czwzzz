---
import { existsSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

const rootDir = join(process.cwd(), 'public', 'gallery');
const imagePattern = /\.(jpe?g|png|gif|webp|avif)$/i;

const getAlbumPhotos = (directory: string, albumName?: string) =>
  readdirSync(directory, { withFileTypes: true })
    .filter((entry) => entry.isFile() && imagePattern.test(entry.name))
    .map((entry) => {
      const filePath = join(directory, entry.name);
      const { mtimeMs } = statSync(filePath);

      return {
        src: albumName ? `/gallery/${albumName}/${entry.name}` : `/gallery/${entry.name}`,
        alt: entry.name.replace(/\.[^/.]+$/, '') || 'photo',
        mtimeMs,
      };
    })
    .sort((a, b) => b.mtimeMs - a.mtimeMs)
    .map(({ src, alt }) => ({ src, alt }));

const albums = [] as Array<{ title: string; cover: string; photos: Array<{ src: string; alt: string }> }>;

if (existsSync(rootDir)) {
  const entries = readdirSync(rootDir, { withFileTypes: true });

  const rootPhotos = getAlbumPhotos(rootDir);

  if (rootPhotos.length > 0) {
    albums.push({
      title: '默认相册',
      cover: rootPhotos[0].src,
      photos: rootPhotos,
    });
  }

  for (const entry of entries) {
    if (!entry.isDirectory()) continue;

    const dirPath = join(rootDir, entry.name);
    const validPhotos = getAlbumPhotos(dirPath, entry.name);

    if (validPhotos.length > 0) {
      albums.push({
        title: entry.name,
        cover: validPhotos[0].src,
        photos: validPhotos,
      });
    }
  }
}

const selectedAlbum = albums[0] ?? null;
---

<BaseLayout title="照片 - czwzzz.my">
  <div class="upload-page">
    <div class="upload-header">
      <p class="page-kicker">MEMORY / ALBUM</p>
      <h1>照片</h1>
    </div>

    <section class="gallery-section" aria-labelledby="gallery-title">
      <div class="section-heading">
        <p class="section-label" id="gallery-title">相册分类</p>
      </div>

      {albums.length > 0 ? (
        <div class="album-grid">
          {albums.map((album) => (
            <button
              type="button"
              class="album-card"
              data-title={album.title}
              data-photos={JSON.stringify(album.photos.map((photo) => photo.src))}
              aria-label={`查看${album.title}`}
            >
              <img src={album.cover} alt={album.title} />
              <div class="album-meta">
                <h2>{album.title}</h2>
                <span>{album.photos.length} 张</span>
              </div>
            </button>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <span>暂无照片</span>
          <p>请将图片放到 public/gallery 或其子分类文件夹中。</p>
        </div>
      )}
    </section>
  </div>

</BaseLayout>
