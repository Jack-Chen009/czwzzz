---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
posts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="推文 / 博客 - czwzzz.my">
  <div class="blog-page">
    <div class="blog-header">
      <p class="blog-eyebrow">BLOG / NOTES</p>
      <h1>博客与推文</h1>
      <p>记录技术探索与日常随笔。</p>
    </div>

    <section class="post-archive" aria-labelledby="archive-title">
      <div class="section-heading">
        <p class="section-label" id="archive-title">文章归档</p>
        <a href="/tags/">查看标签 →</a>
      </div>

      <div class="post-list">
        {posts.map((post: CollectionEntry<'blog'>) => (
          <article class="post-card">
            <div class="post-card-main">
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              {post.data.description && <p>{post.data.description}</p>}
            </div>
            <div class="post-card-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </time>
              {post.data.tags?.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag: string) => <span>#{tag}</span>)}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>


