---
// src/pages/blog/[...slug].astro
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
  return posts.map((post: CollectionEntry<'blog'>) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} - czwzzz.my`} description={post.data.description}>
  <div class="article-page">
    <article class="article-shell">
      <header class="article-header">
        <a href="/blog/" class="article-back">
          <span aria-hidden="true">←</span>
          <span>返回文章列表</span>
        </a>
        <p class="article-eyebrow">BLOG / ARTICLE</p>
        <h1>
        {post.data.title}
        </h1>

        <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          发布于 {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
        </time>

        {/* 详情页顶部的标签 */}
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <a 
                href={`/tags/${tag}/`} 
                  class="article-tag"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
        </div>
      </header>

      <div class="article-content prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>