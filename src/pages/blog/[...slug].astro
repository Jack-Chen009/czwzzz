---
// src/pages/blog/[...slug].astro
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
  return posts.map((post: CollectionEntry<'blog'>) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} - czwzzz.my`} description={post.data.description}>
  <main class="max-w-3xl mx-auto px-6 py-12">
    {/* 文章页头 */}
    <header class="mb-8">
      <a href="/blog/" class="text-sm text-blue-600 dark:text-blue-400 hover:underline mb-4 inline-block">
        ← 返回文章列表
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight leading-tight">
        {post.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 mt-4 text-sm text-gray-500 border-b pb-6 border-gray-100 dark:border-gray-800">
        <time datetime={post.data.pubDate.toISOString()}>
          发布于 {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
        </time>

        {/* 详情页顶部的标签 */}
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <a 
                href={`/tags/${tag}/`} 
                class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-600 hover:bg-blue-100 dark:bg-blue-950/50 dark:text-blue-300 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    {/* Markdown 自动美化排版容器 */}
    <div class="prose dark:prose-invert max-w-none">
      <Content />
    </div>
  </main>
</BaseLayout>