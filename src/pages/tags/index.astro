---
// src/pages/tags/index.astro
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 1. 获取所有未标记为草稿的文章
const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);

// 2. 统计每个标签对应的文章数量
const tagCounts = posts.reduce((acc: Record<string, number>, post: CollectionEntry<'blog'>) => {
  post.data.tags?.forEach((tag: string) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {});

// 3. 提取所有唯一标签并按字母排序
const allTags = Object.keys(tagCounts).sort();
---

<BaseLayout title="标签 - czwzzz.my">
  <main class="tag-index-page">
    {/* 页面头部 */}
    <header class="mb-10 pb-4 border-b border-gray-200 dark:border-gray-800">
      <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white">
        标签
      </h1>
      <p class="mt-2 text-gray-500 dark:text-gray-400">
        共计 {allTags.length} 个分类标签，点击即可查看相关文章。
      </p>
    </header>

    {/* 标签网格 */}
    <div class="tag-index-grid">
      {allTags.map((tag: string) => (
        <a href={`/tags/${tag}/`} class="tag-index-link">
          <span>#{tag}</span>
          <span class="tag-index-count">
            {tagCounts[tag]}
          </span>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>