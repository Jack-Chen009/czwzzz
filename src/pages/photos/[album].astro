---
import { existsSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Photo {
  src: string;
  originalSrc: string;
  alt: string;
}

export function getStaticPaths() {
  const rootDir = join(process.cwd(), 'public', 'gallery');
  const imagePattern = /\.(jpe?g|png|gif|webp|avif)$/i;
  const getAlbumPhotos = (directory: string, albumName?: string): Photo[] =>
    readdirSync(directory, { withFileTypes: true })
      .filter((entry) => entry.isFile() && imagePattern.test(entry.name))
      .map((entry) => {
        const filePath = join(directory, entry.name);
        const { mtimeMs } = statSync(filePath);

        return {
          src: albumName ? `/gallery-optimized/${albumName}/${entry.name.replace(/\.[^/.]+$/, '.webp')}` : `/gallery-optimized/${entry.name.replace(/\.[^/.]+$/, '.webp')}`,
          originalSrc: albumName ? `/gallery/${albumName}/${entry.name}` : `/gallery/${entry.name}`,
          alt: entry.name.replace(/\.[^/.]+$/, '') || 'photo',
          mtimeMs,
        };
      })
      .sort((a, b) => b.mtimeMs - a.mtimeMs)
      .map(({ src, originalSrc, alt }) => ({ src, originalSrc, alt }));

  if (!existsSync(rootDir)) return [];

  const folders = readdirSync(rootDir, { withFileTypes: true }).filter((entry) => entry.isDirectory());
  if (folders.length > 0) {
    return folders.flatMap((folder) => {
      const photos = getAlbumPhotos(join(rootDir, folder.name), folder.name);
      return photos.length > 0 ? [{ params: { album: folder.name }, props: { title: folder.name, photos } }] : [];
    });
  }

  const photos = getAlbumPhotos(rootDir);
  return photos.length > 0 ? [{ params: { album: 'default' }, props: { title: '默认相册', photos } }] : [];
}

const { title, photos } = Astro.props;
---

<BaseLayout title={`${title} - 照片 - czwzzz.my`}>
  <div class="upload-page album-page">
    <a class="album-back-link" href="/photo">← 返回 /photo</a>

    <header class="upload-header album-page-header">
      <p class="page-kicker">MEMORY / {title}</p>
      <h1>{title}</h1>
      <p>{photos.length} 张照片</p>
    </header>

    <section class="photo-wall" aria-label={`${title}中的照片`}>
      {photos.map((photo) => (
        <figure
          class="photo-tile"
          role="button"
          tabindex="0"
          data-original-src={photo.originalSrc}
          data-alt={photo.alt}
          data-orientation="unknown"
          aria-label={`查看${photo.alt}原图`}
        >
          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
        </figure>
      ))}
    </section>

    <div class="photo-lightbox" id="photoLightbox" aria-hidden="true">
      <div class="photo-lightbox-backdrop" data-lightbox-close></div>
      <div class="photo-lightbox-content" role="dialog" aria-modal="true" aria-label="原图预览">
        <button class="photo-lightbox-close" type="button" data-lightbox-close aria-label="关闭原图预览">×</button>
        <img id="lightboxImage" src="" alt="" />
        <div class="photo-lightbox-actions">
          <a id="lightboxDownload" class="photo-download-button" href="" download>下载原图</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const lightbox = document.getElementById('photoLightbox');
  const lightboxImage = document.getElementById('lightboxImage') as HTMLImageElement | null;
  const lightboxDownload = document.getElementById('lightboxDownload') as HTMLAnchorElement | null;
  const tiles = document.querySelectorAll<HTMLElement>('.photo-tile');

  const setPhotoOrientation = (tile: HTMLElement) => {
    const image = tile.querySelector('img');
    if (!image || !image.naturalWidth || !image.naturalHeight) return;

    const orientation = image.naturalWidth === image.naturalHeight
      ? 'square'
      : image.naturalWidth > image.naturalHeight
        ? 'landscape'
        : 'portrait';
    tile.dataset.orientation = orientation;
  };

  const closeLightbox = () => {
    lightbox?.classList.remove('is-open');
    lightbox?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('lightbox-open');
    if (lightboxImage) lightboxImage.removeAttribute('src');
  };

  const openLightbox = (tile: HTMLElement) => {
    const originalSrc = tile.dataset.originalSrc;
    const alt = tile.dataset.alt || '原图';
    if (!originalSrc || !lightbox || !lightboxImage || !lightboxDownload) return;

    lightboxImage.src = originalSrc;
    lightboxImage.alt = alt;
    lightboxDownload.href = originalSrc;
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('lightbox-open');
  };

  tiles.forEach((tile) => {
    const image = tile.querySelector('img');
    image?.addEventListener('load', () => setPhotoOrientation(tile), { once: true });
    setPhotoOrientation(tile);
    tile.addEventListener('click', () => openLightbox(tile));
    tile.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openLightbox(tile);
      }
    });
  });

  lightbox?.querySelectorAll('[data-lightbox-close]').forEach((element) => {
    element.addEventListener('click', closeLightbox);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox?.classList.contains('is-open')) closeLightbox();
  });
</script>
