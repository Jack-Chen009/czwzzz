---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Typewriter from '../components/Typewriter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

// 1. 获取所有非草稿文章，按日期倒序，取最新 3 篇
const allPosts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
const recentPosts = allPosts
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => 
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  )
  .slice(0, 3);

// 2. 格式化月份为 "08月"
const formatMonth = (date: Date) => {
  return String(date.getMonth() + 1).padStart(2, '0') + '月';
};
---

<BaseLayout title="(￣o￣) zzZ💤">
  <section class="hero" id="home">
    <p class="greeting">歡迎你嚟^_^</p>
    <h1 class="main-title">
      <Typewriter />
    </h1>

    <div class="content-list">
      <div class="list-group home-links">
        <a class="home-link" href="#works"><span class="home-link-index">01</span><span>作品</span><span class="home-link-arrow" aria-hidden="true">↗</span></a>
        <a class="home-link" href="#projects"><span class="home-link-index">02</span><span>脚本</span><span class="home-link-arrow" aria-hidden="true">↗</span></a>
        <a class="home-link" href="/blog"><span class="home-link-index">03</span><span>推文</span><span class="home-link-arrow" aria-hidden="true">↗</span></a>
        <a class="home-link" href="/photos"><span class="home-link-index">04</span><span>相册</span><span class="home-link-arrow" aria-hidden="true">↗</span></a>
        <a class="home-link" href="#resources"><span class="home-link-index">05</span><span>资源</span><span class="home-link-arrow" aria-hidden="true">↗</span></a>
        <a class="home-link" href="#events"><span class="home-link-index">06</span><span>讯息</span><span class="home-link-arrow" aria-hidden="true">↗</span></a>
        <a class="home-link" href="#games"><span class="home-link-index">07</span><span>游戏</span><span class="home-link-arrow" aria-hidden="true">↗</span></a>
        <a class="home-link" href="/contact"><span class="home-link-index">08</span><span>联系</span><span class="home-link-arrow" aria-hidden="true">↗</span></a>
      </div>

      <div class="list-divider"></div>

      <div class="timeline-title">最近更新</div>

      {/* 动态渲染最近更新的文章，并在每条中插入标签链接 */}
      {recentPosts.map((post: CollectionEntry<'blog'>) => (
        <div class="timeline-item">
          <span class="timeline-date">{formatMonth(post.data.pubDate)}</span>
          
          {/* 这里就是你要插入的标签 map，它现在有明确的 post 上下文 */}
          {post.data.tags.map((tag: string) => (
            <a href={`/tags/${tag}/`} class="timeline-tag">#{tag}</a>
          ))}

          <div class="timeline-text">
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </div>
        </div>
      ))}

      {/* 如果还没有文章，显示占位提示 */}
      {recentPosts.length === 0 && (
        <div class="timeline-item">
          <span class="timeline-date">--</span>
          <span class="timeline-tag">暂无</span>
          <div class="timeline-text">
            <span>暂无更新</span>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>